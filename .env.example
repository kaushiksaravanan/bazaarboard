# BazaarBoard env vars — all server-side. Never NEXT_PUBLIC_-prefix any
# of these. Copy to .env.local for local dev; set the same on the Vercel
# project for prod.

# Gemini API key. Provisioned by Google DeepMind at 10:30 AM per the
# participant guide on hackathon day; before then, any Gemini-capable key
# works with the fallback model. The /api/generate route reads this and
# forwards to the model set by NB2_MODEL. Users can also paste a key at
# runtime through the in-app BYOK modal; that key is held in the tab's
# sessionStorage only and is preferred over this env var when present.
GEMINI_API_KEY=your-key-here

# Override the model. Leave commented out to use the pre-hackathon
# stand-in "gemini-2.5-flash-image-preview" so local dev works before
# the day-of credentials arrive. On hackathon morning, uncomment and
# set to the NB2 Lite model id.
# NB2_MODEL=gemini-3.1-flash-lite-image
